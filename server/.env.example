# Copy to server/.env and fill in. Never commit the real .env.

# Port for the server (hosts like Railway set PORT themselves).
API_PORT=4000

# The platform's domain: shops live at <link>.PLATFORM_DOMAIN. Point a wildcard DNS record (*.shop.ke) and
# the bare domain at this server, with a wildcard TLS certificate (see README).
PLATFORM_DOMAIN=shop.ke
# Who runs the platform (landing page, wizard, and "Website by …" in every shop's footer).
PLATFORM_NAME=Kabuor Builds
PLATFORM_TAGLINE=Mlete deals.
PLATFORM_PHONE=0705 607 954
PLATFORM_EMAIL=rooneykabuor2004@gmail.com
# Your dashboard at <domain>/admin: signs in with PLATFORM_ADMIN_EMAIL (defaults to PLATFORM_EMAIL) and this password.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# The platform's public https address (for M-Pesa callbacks), e.g. https://shop.ke
PUBLIC_URL=

# Signs every shop's admin sessions (each shop gets its own key derived from this). Use a long random string.
JWT_SECRET=

# Where databases and uploads are kept (defaults to server/data, or the Railway volume).
DATA_DIR=

# Subscription prices in KSh.
PLATFORM_PRICE_MONTHLY=1500
PLATFORM_PRICE_YEARLY=15000

# The platform's M-Pesa Express (STK push) keys, for owners paying their plan. From
# https://developer.safaricom.co.ke after "Go Live" for the platform's own Paybill or Till.
# Leave blank for test mode: no prompt is sent and payments complete by themselves (marked "test").
PLATFORM_MPESA_ENV=sandbox
PLATFORM_MPESA_CONSUMER_KEY=
PLATFORM_MPESA_CONSUMER_SECRET=
PLATFORM_MPESA_SHORTCODE=
PLATFORM_MPESA_PASSKEY=
# Buy Goods only: the till number owners pay (PLATFORM_MPESA_SHORTCODE is then the store number).
PLATFORM_MPESA_TILL=

# SMS through Africa's Talking (order texts for every shop, sent from the platform's account).
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
