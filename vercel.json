{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:company -w client",
  "outputDirectory": "client/dist-company",
  "rewrites": [
    {
      "source": "/((?!assets/|brand/|fonts/).*)",
      "destination": "/index.html"
    }
  ]
}
